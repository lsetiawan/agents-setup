{
  "autoUpdate": true,
  "autoCompactThreshold": 60,
  "notifications": false,
  "telemetry": "off",
  "effortLevel": "medium",
  "theme": "light",
  "sandbox": {
    "failIfUnavailable": true
  },
  "bash": {
    "allowedCommands": [
      "git status",
      "git diff",
      "npm test",
      "ls -la",
      "pwd",
      "cat"
    ],
    "deniedCommands": [
      "sudo",
      "chmod 777",
      "rm -rf /",
      "git push --force"
    ]
  },
  "availableModels": ["haiku", "sonnet", "opus"],
  "enforceAvailableModels": true
}
