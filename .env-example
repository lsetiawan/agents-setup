# Upstream LiteLLM gateway. This is what the local proxy forwards to; the agent
# containers never see it — they talk to the local proxy instead.
ANTHROPIC_BASE_URL=BASE_URL
ANTHROPIC_AUTH_TOKEN=api_key

# --- Local LiteLLM proxy (pixi run litellm) --------------------------------

# Key clients present to the local proxy, including the agent containers. The
# launcher sets it as the container's ANTHROPIC_AUTH_TOKEN. Required.
LITELLM_MASTER_KEY=sk-1234

# Where the proxy forwards Anthropic traffic. Defaults to ANTHROPIC_BASE_URL /
# ANTHROPIC_AUTH_TOKEN above, which is usually what you want. Set these only if
# you also point ANTHROPIC_BASE_URL at something else.
# LITELLM_UPSTREAM_BASE_URL=https://your-gateway.example.com
# LITELLM_UPSTREAM_API_KEY=sk-...

# Local Postgres for spend logs and virtual keys. Defaults to the cluster
# start_litellm.sh creates under .litellm/pgdata.
# DATABASE_URL=postgresql://litellm@127.0.0.1:5432/litellm_db

# Local models served by oMLX. The proxy reaches these from the host, so
# 127.0.0.1 is right even though the agents run in containers.
OMLX_API_BASE=http://127.0.0.1:8999/v1
OMLX_API_KEY=omlx_api_key

# --- Agent containers ------------------------------------------------------

# Port the proxy listens on, and that containers dial it on. Both
# start_litellm.sh and start_claude_vm.sh read it.
# LITELLM_PORT=4000

# Address containers use to reach the host. Discovered from Colima's network by
# default; set it only if that discovery picks the wrong interface.
# AGENTS_HOST_IP=192.168.64.1

# Model names as the local proxy advertises them (scripts/litellm/config.yaml).
# The launcher pushes these into the container; override them here if you rename
# models in that config.
# ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-5
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-5
# ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5
# ANTHROPIC_MODEL=sonnet
