# Upstream LiteLLM gateway. The agent containers read these two directly; the
# local proxy inherits them as its upstream unless LITELLM_UPSTREAM_* is set.
ANTHROPIC_BASE_URL=BASE_URL
ANTHROPIC_AUTH_TOKEN=api_key

# --- Local LiteLLM proxy (pixi run litellm) --------------------------------

# Key clients present to the local proxy. Point agents at it with
# ANTHROPIC_BASE_URL=http://127.0.0.1:4000 and ANTHROPIC_AUTH_TOKEN=<this>,
# and set LITELLM_UPSTREAM_* below so the proxy still knows its real upstream.
LITELLM_MASTER_KEY=sk-1234

# Where the proxy forwards Anthropic traffic. Defaults to ANTHROPIC_BASE_URL /
# ANTHROPIC_AUTH_TOKEN when unset; set them explicitly once ANTHROPIC_BASE_URL
# points at the local proxy.
# LITELLM_UPSTREAM_BASE_URL=https://your-gateway.example.com
# LITELLM_UPSTREAM_API_KEY=sk-...

# Local Postgres for spend logs and virtual keys. Defaults to the cluster
# start_litellm.sh creates under .litellm/pgdata.
# DATABASE_URL=postgresql://litellm@127.0.0.1:5432/litellm_db

# Local models served by oMLX. Use 127.0.0.1 when the proxy runs on the host;
# from an incus container use http://192.168.64.1:8999/v1, which also needs
# oMLX bound to 0.0.0.0 rather than loopback.
OMLX_API_BASE=http://127.0.0.1:8999/v1
OMLX_API_KEY=omlx_api_key
